import pepita.*

describe "Tests de Pepita" {

    test "comportamiento básico de Pepita" {
        //act
        pepita.volar(200)
        //assert 
        assert.notThat(pepita.estaCansado())
        //act 
        pepita.volar(350)
        //assert
        assert.that(pepita.estaCansado())
        //act
        pepita.descansar()
        //assert
        assert.notThat(pepita.estaCansado())
    }



    test "alimentar a Pepita" {
        //act
        pepita.volar(900)
        //assert
        assert.that(pepita.estaCansado())
        //act 
        pepita.comer(alpiste)
        //assert
        assert.that(pepita.estaCansado())
        //act 
        pepita.comer(alpiste)
        //assert
        assert.notThat(pepita.estaCansado())
    }



    test "dieta variada" {
        //act
        pepita.volar(900)
        //assert
        assert.that(pepita.estaCansado())
        //act
        manzana.gradoMadurez(2)
        //assert
        assert.equals(40, manzana.energiaQueAporta())
        //act 
        pepita.comer(manzana)
        //asser
        assert.notThat(pepita.estaCansado())
    }



    test "Pepon" {
        //assert
        assert.that(pepon.estaCansado())
        //assert
        assert.equals(30, pepon.energia())
        //act 
        pepon.comer(alpiste)
        //assert
        assert.equals(42.5, pepon.energia())
        //assert
        assert.notThat(pepon.estaCansado())
    }



    test "Pepon 2" {
        //assert
        assert.equals(30, pepon.energia())
        //act 
        pepon.volar(3)
        //assert
        assert.equals(4, pepon.energia())
        //assert
        assert.that(pepon.estaCansado())
    }



    test "Rebeca con Pepon"{
        //act 
        rebeca.ave(pepon)
        //assert
        assert.equals(pepon, rebeca.ave())
        //assert
        assert.equals(30, pepon.energia())
        //act 
        rebeca.alimentar(alpiste)
        //assert
        assert.equals(42.5, pepon.energia())
    }



    test "Rebeca con Pepita" {
        //act 
        rebeca.ave(pepita)
        //assert 
        assert.equals(pepita, rebeca.ave())
        //assert
        assert.equals(100, pepita.energia())
        //act 
        rebeca.alimentar(alpiste)
        //assert 
        assert.equals(125, pepita.energia())
    }



    test "cenas pepon" {
        //act 
        rebeca.ave(pepita)
        rebeca.alimentar(manzana)
        rebeca.alimentar(alpiste)
        //assert
        assert.equals(2, rebeca.cenas())
        //act 
        rebeca.ave(pepon)
        rebeca.alimentar(manzana)
        //assert
        assert.equals(1, rebeca.cenas())
        //act 
        rebeca.ave(pepita)
        //assert
        assert.equals(0, rebeca.cenas())
    }



    test "cenas con misma ave" {
        //act 
        rebeca.ave(pepita)
        rebeca.alimentar(manzana)
        rebeca.alimentar(manzana)
        rebeca.alimentar(alpiste)
        //assert
        assert.equals(3, rebeca.cenas())
        //act 
        rebeca.ave(pepita)
        //assert
        assert.equals(0, rebeca.cenas())
    }
}